# JRG Chicken VPS Production Environment Configuration

# 1. Server Configuration
PORT=3000
NODE_ENV=production

# 2. PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres_secure_password_2026@127.0.0.1:5432/jrg_chicken

# 3. JWT Secret Key (Use a strong random string in production)
JWT_SECRET=jrg_chicken_super_secret_jwt_key_2026_prod

# 4. Optional: Firebase Admin SDK Credentials (for FCM Push Notifications)
FIREBASE_PROJECT_ID=jrg-chicken-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jrg-chicken-production.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 5. Google OAuth Client ID (for "Continue with Google" Auth)
VITE_GOOGLE_CLIENT_ID=541137574724-oh1338i1f0na9e8fqkklnbato310n1lg.apps.googleusercontent.com

# 6. Production App & CORS Domain Configuration
VITE_APP_URL=https://jrgchicken.in
CORS_ORIGIN=https://jrgchicken.in,https://www.jrgchicken.in

